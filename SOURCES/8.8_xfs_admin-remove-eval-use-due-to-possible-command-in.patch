From 219b4754fadb7efc1c0de5ac1f46f037b75b3343 Mon Sep 17 00:00:00 2001
From: Andrey Albershteyn <aalbersh@kernel.org>
Date: Mon, 19 Oct 2026 11:16:20 +0200
Subject: [PATCH] xfs_admin: remove eval use due to possible command injection

The -L (label) argument is 12 bytes string which is reparsed by eval out
of the crafted arguments string. The label could be crafted to fail
xfs_db command and continue with user injected command.

In the scenario when user provided arguments are passed to the xfs_admin
running under root, this leads to root command injection.

Fix this by removing use of eval and instead set a bunch of boolean
and value flags. These are latter appended to the empty set of
positional parameters $@. These parameters are not parsed.

Reported-by: Hazley Samsudin <muhammad_hazley_samsudin_from.tp@tech.gov.sg>
Signed-off-by: Andrey Albershteyn <aalbersh@kernel.org>

[ Backported to xfsprogs 5.0.0 (RHEL-8.8). The upstream commit targets a
  much newer db/xfs_admin.sh that supports -C/-O/-r options, mounted-fs
  handling via findmnt, xfs_io/xfs_spaceman dispatch and a log device
  argument, none of which exist in 5.0.0. The hunks were reworked to the
  5.0.0 script, which only has DB_OPTS/REPAIR_OPTS and the -efjlpuc:L:U:V
  option set. The same fix is applied: eval is removed and arguments are
  built verbatim via the positional parameters ($@). The 5.0.0-specific
  repair stderr redirection and "Conversion failed" message are preserved. ]
---
 db/xfs_admin.sh | 85 ++++++++++++++++++++++++++++++++++++++++-----------------
 1 file changed, 61 insertions(+), 24 deletions(-)

diff --git a/db/xfs_admin.sh b/db/xfs_admin.sh
index 13a876ad8d13..6b2102815cd7 100755
@@ -5,22 +5,54 @@
 #
 
 status=0
-DB_OPTS=""
-REPAIR_OPTS=""
+have_db=""
+have_repair=""
+opt_extflg=""			# -e
+opt_force=""			# -f
+opt_log2=""			# -j
+opt_projid32bit=""		# -p
+opt_get_label=""		# -l
+opt_get_uuid=""			# -u
+opt_set_label=""		# -L
+set_label=""
+opt_set_uuid=""			# -U
+set_uuid=""
+repair_tokens=""
+
 USAGE="Usage: xfs_admin [-efjlpuV] [-c 0|1] [-L label] [-U uuid] device"
 
 while getopts "efjlpuc:L:U:V" c
 do
 	case $c in
-	c)	REPAIR_OPTS=$REPAIR_OPTS" -c lazycount="$OPTARG;;
-	e)	DB_OPTS=$DB_OPTS" -c 'version extflg'";;
-	f)	DB_OPTS=$DB_OPTS" -f";;
-	j)	DB_OPTS=$DB_OPTS" -c 'version log2'";;
-	l)	DB_OPTS=$DB_OPTS" -r -c label";;
-	L)	DB_OPTS=$DB_OPTS" -c 'label "$OPTARG"'";;
-	p)	DB_OPTS=$DB_OPTS" -c 'version projid32bit'";;
-	u)	DB_OPTS=$DB_OPTS" -r -c uuid";;
-	U)	DB_OPTS=$DB_OPTS" -c 'uuid "$OPTARG"'";;
+	c)	repair_tokens="$repair_tokens lazycount=$OPTARG"
+		have_repair=1
+		;;
+	e)	opt_extflg=1
+		have_db=1
+		;;
+	f)	opt_force=1
+		have_db=1
+		;;
+	j)	opt_log2=1
+		have_db=1
+		;;
+	l)	opt_get_label=1
+		have_db=1
+		;;
+	L)	opt_set_label=1
+		set_label=$OPTARG
+		have_db=1
+		;;
+	p)	opt_projid32bit=1
+		have_db=1
+		;;
+	u)	opt_get_uuid=1
+		have_db=1
+		;;
+	U)	opt_set_uuid=1
+		set_uuid=$OPTARG
+		have_db=1
+		;;
 	V)	xfs_db -p xfs_admin -V
 		status=$?
 		exit $status
@@ -30,22 +62,47 @@
 		;;
 	esac
 done
-set -- extra $@
+set -- extra "$@"
 shift $OPTIND
+device=$1
+
+# We use a bunch of opt_* flags here instead of crafting argument strings
+# directly in the getopts loop above. This is because passing such strings
+# to eval could cause command injection.
+#
+# As we cannot use arrays in POSIX, instead we resort to using the positional
+# parameters ($@). Before calling any of the xfs_* utilities we reset $@ to an
+# empty set with "set --". Then, based on the flags parsed above, we append all
+# necessary arguments. This way each argument is passed verbatim, without being
+# re-parsed or word-split by the shell.
 case $# in
-	1)	if [ -n "$DB_OPTS" ]
+	1)	if [ -n "$have_db" ]
 		then
-			eval xfs_db -x -p xfs_admin $DB_OPTS $1
+			set --
+			[ -n "$opt_extflg" ] && set -- "$@" -c "version extflg"
+			[ -n "$opt_force" ] && set -- "$@" -f
+			[ -n "$opt_log2" ] && set -- "$@" -c "version log2"
+			[ -n "$opt_get_label" ] && set -- "$@" -r -c label
+			[ -n "$opt_set_label" ] && set -- "$@" -c "label $set_label"
+			[ -n "$opt_projid32bit" ] && set -- "$@" -c "version projid32bit"
+			[ -n "$opt_get_uuid" ] && set -- "$@" -r -c uuid
+			[ -n "$opt_set_uuid" ] && set -- "$@" -c "uuid $set_uuid"
+			xfs_db -x -p xfs_admin "$@" "$device"
 			status=$?
 		fi
-		if [ -n "$REPAIR_OPTS" ]
+		if [ -n "$have_repair" ]
 		then
 			# Hide normal repair output which is sent to stderr
 			# assuming the filesystem is fine when a user is
 			# running xfs_admin.
 			# Ideally, we need to improve the output behaviour
 			# of repair for this purpose (say a "quiet" mode).
-			eval xfs_repair $REPAIR_OPTS $1 2> /dev/null
+			set --
+			for token in $repair_tokens
+			do
+				set -- "$@" -c "$token"
+			done
+			xfs_repair "$@" "$device" 2> /dev/null
 			status=`expr $? + $status`
 			if [ $status -ne 0 ]
 			then
-- 
2.54.0

